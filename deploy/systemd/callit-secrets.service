# Fetches the production secrets from 1Password into /run/callit/secrets
# (tmpfs) at boot, before Docker restarts the stack, and again on
# `systemctl restart`, which deploy.sh runs before every deploy.
# Installed by deploy/install-secrets.sh; runbook: deploy/README.md §4.
#
# If 1Password is unreachable at boot this unit fails, the secret files
# don't exist, and the containers can't start: downtime, never a start with
# missing secrets.
[Unit]
Description=CallIt production secrets from 1Password
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The one secret on disk: a read-only service account token scoped to the
# callit-prod vault. systemd hands it to the script as a credential file,
# readable only by this unit, instead of an environment variable.
LoadCredential=op-token:/etc/callit/op-service-account-token
Environment=CALLIT_SECRETS_DIR=/run/callit/secrets
ExecStart=/usr/local/libexec/callit-secrets

[Install]
WantedBy=multi-user.target
